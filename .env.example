# Payrello Docker Environment Configuration
# Copy this file to .env and adjust values before running docker compose

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8080                      # Host port — must NOT be 80 on localhost (see note below)

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=payrello
DB_USER=payrello
DB_PASS=payrello_secret            # Change before going to production
DB_ROOT_PASSWORD=root_secret       # Change before going to production
DB_PREFIX=pp_

# ── Admin Account (used on first boot only) ────────────────────────────────────
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234          # Change before going to production

# ── phpMyAdmin (optional, enabled with --profile tools) ───────────────────────
PMA_PORT=8181

# ── Access URLs ───────────────────────────────────────────────────────────────
# IMPORTANT: The app detects http://localhost (port 80) and breaks asset paths.
# Always use a non-standard port so HTTP_HOST becomes "localhost:8080" not "localhost".
# Login:      http://localhost:8080/login
# Dashboard:  http://localhost:8080/admin/dashboard
# phpMyAdmin: http://localhost:8181  (when started with --profile tools)
